        </mxCell>
        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#555555;strokeWidth=1.4;" edge="1" parent="1" source="l1" target="far">
          <mxGeometry relative="1" as="geometry" />
